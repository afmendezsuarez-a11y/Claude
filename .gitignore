# Datos crudos binarios/pesados: NO se versionan, pero su procedencia sí queda
# registrada en data/raw/SOURCES.md (URL, fecha, tamaño, SHA256).
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.zip
data/raw/pdf/*.pdf

# Excepción: los insumos realmente usados por la corrida sí se versionan, para
# que el resultado sea reproducible sin volver a conseguirlos.
!data/raw/inei_vab_ica.xlsx
data/raw/pdf_text/

# Intermedios regenerables
data/processed/

# Sandboxes de los tests
/tmp/eldu_smoke_*

.Rhistory
.RData
.Rproj.user/
renv/library/

# Auxiliares de LaTeX (el PDF y los insumos generados sí se versionan)
report/*.aux
report/*.log
report/*.out
report/*.fls
report/*.fdb_latexmk
report/*.toc
report/*.synctex.gz
